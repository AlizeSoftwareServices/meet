# ==============================================================================
# Meet / Calendly Clone Backend Environment Template
# NEVER commit real production secrets, passwords, or private keys to git!
# ==============================================================================

# Server
PORT=3001
NODE_ENV=production

# Database (PostgreSQL recommended for production)
DATABASE_URL=postgresql://meet_user:replace_with_secure_password@localhost:5432/meetdb?schema=public

# Authentication & JWT
JWT_SECRET=replace_with_a_64_character_hex_or_base64_high_entropy_secret_string
JWT_EXPIRES_IN=7d

# URLs & CORS
FRONTEND_URL=https://meet.alizesoftwareservices.com
API_BASE_URL=https://api.meet.alizesoftwareservices.com
CORS_ORIGINS=https://meet.alizesoftwareservices.com,capacitor://localhost,http://localhost:3000
MOBILE_DEEP_LINK_SCHEME=meetapp

# Email & Notifications (SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASSWORD=replace_with_your_sendgrid_or_mailgun_api_key
SMTP_FROM="Meet" <notifications@meet.alizesoftwareservices.com>

# Google Calendar & OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://api.meet.alizesoftwareservices.com/integrations/google/callback

# Microsoft Outlook & OAuth (Optional)
MICROSOFT_CLIENT_ID=your_azure_ad_app_id
MICROSOFT_CLIENT_SECRET=your_azure_ad_client_secret
MICROSOFT_REDIRECT_URI=https://api.meet.alizesoftwareservices.com/integrations/microsoft/callback

# Slack Webhook Integration (Optional)
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_REDIRECT_URI=https://api.meet.alizesoftwareservices.com/integrations/slack/callback

# Firebase Cloud Messaging (FCM Push Notifications - Optional)
FIREBASE_PROJECT_ID=meet-production
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@meet-production.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
